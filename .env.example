# Copy to .env and fill in locally. Never commit .env.

# Gmail SMTP self-test (two accounts you control)
GMAIL_SMTP_USER=account-a@example.com
GMAIL_SMTP_TO=account-b@example.com
GMAIL_SMTP_APP_PASSWORD=

# Optional defense-demo levers (midflag)
# GMAIL_SMTP_REPLY_TO=finance@demo-lieferant.invalid
# GMAIL_SMTP_FROM_NAME=Demo Supplier GmbH

# Portal hop URL (blogspot or your static redirect)
DEMO_PORTAL_URL=https://YOUR-BLOG.blogspot.com/2026/10/freigabe-r-2026-1847.html

# Harmless redirect target for static pages (default Rick Roll awareness demo)
# DEMO_YOUTUBE_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# Static deploy (optional)
# LAB_REDIRECT_HOST=your-training-host
# LAB_REDIRECT_PATH=/var/www/lab-redirect/
